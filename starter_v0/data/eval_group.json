      "phase": "B",
      "suite": "group",
      "query": "Kiểm tra riêng kết nối mạng trên laptop LT-318.",
      "failure_type": "wrong_arg_value",
      "expect": {
        "tool_calls": [
          {
            "name": "inspect_device",
            "args": {
              "asset_id": "LT-318",
              "check": "network"
            }
          }
        ]
      },
      "metadata": {
        "skill": "device_network_check",
        "difficulty": "easy",
        "what_it_tests": "Trích đúng asset ID và chọn check=network."
      }
